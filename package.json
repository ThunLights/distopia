{
  "name": "distopia-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "setup": "bun run prepare && turbo run setup",
    "typecheck": "turbo run typecheck",
    "deploy-db": "turbo run deploy-db",
    "version": "npx changeset version && turbo run version:jsr",
    "prepare": "husky",
    "storybook": "turbo run storybook",
    "build-storybook": "turbo run build-storybook"
  },
  "packageManager": "bun@1.4.0",
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "bun": "catalog:",
    "husky": "9.1.7",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "skills": "1.5.23",
    "turbo": "2.10.10"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "workspaces": {
    "packages": [
      "./lib/*",
      "./src/**/*"
    ],
    "catalog": {
      "@discordjs/voice": "0.19.2",
      "@noble/ciphers": "2.4.0",
      "@standard-schema/spec": "1.1.0",
      "@types/node": "24.13.3",
      "bun": "1.4.0",
      "discord.js": "14.27.0",
      "ffmpeg-static": "5.3.0",
      "opusscript": "0.1.1",
      "oxfmt": "0.63.0",
      "oxlint": "1.79.0",
      "prism-media": "1.3.5",
      "smol-toml": "1.8.0",
      "typescript": "6.0.3",
      "vitest": "4.1.11",
      "zod": "4.4.3"
    }
  }
}
