{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "paths": {
      "$distopia-template/*": ["../template/src/*"],
      "$infra-http/*": ["../../src/infrastructure/http/src/*"],
      "$infra-rpc/*": ["../../src/infrastructure/rpc/src/*"]
