{
  "$schema": "./node_modules/turbo/schema.json",
  "cacheDir": ".cache/turbo",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build", "^test"],
      "cache": false
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "setup": {
      "dependsOn": ["^setup"],
      "cache": false
    },
    "typecheck": {
      // "build"/"^build" alongside "^typecheck": some packages' own types only exist after
      // their own build (infra-rpc's buf-generated src/gen/, distopia's dist/index.d.mts --
      // see CLAUDE.md's package.json "exports" pointing there, not at src/). Without this, a
      // bare `bun run typecheck` with no prior build fails on any package depending on one
      // of those, same reasoning as "test" already depending on "build" above.
      "dependsOn": ["build", "^build", "^typecheck"]
    },
    "deploy-db": {
      "dependsOn": ["^deploy-db"],
      "cache": false
    },
    "storybook": {
      "dependsOn": ["^storybook"],
      "cache": false
    },
    "build-storybook": {
      "dependsOn": ["^build-storybook"],
      "cache": false
    },
    "version:jsr": {
      "dependsOn": ["^version:jsr"],
      "outputs": ["jsr.json"]
    }
  }
}
