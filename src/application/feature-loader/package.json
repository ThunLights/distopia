    "feature-help": "workspace:*",
    "feature-log": "workspace:*",
    "feature-owner": "workspace:*",
    "feature-page": "workspace:*",
    "feature-rank": "workspace:*",
    "feature-review": "workspace:*",
    "feature-role-panel": "workspace:*",
    "feature-staff": "workspace:*",
    "feature-stat-channel": "workspace:*",
    "feature-stats": "workspace:*",
    "feature-sticky-message": "workspace:*",
    "feature-ticket": "workspace:*",
    "feature-tts": "workspace:*",
    "feature-verify": "workspace:*",
    "feature-web": "workspace:*",
    "feature-welcome-message": "workspace:*",
