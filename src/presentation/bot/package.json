{
  "name": "presentation-bot",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "bun run scripts/cmdGen.ts",
    "setup": "npm run build",
    "start": "bun run src/index.ts",
    "dev": "bun --env-file=../../../.env run src/index.ts",
    "test": "vitest run",
    "lint": "oxfmt --check --config ../../../lib/template/oxfmt.config.ts && oxlint --config ../../../lib/template/oxlint.config.ts",
    "lint:fix": "oxlint --fix --config ../../../lib/template/oxlint.config.ts",
    "format": "oxfmt --config ../../../lib/template/oxfmt.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@connectrpc/connect": "catalog:",
    "@connectrpc/connect-node": "catalog:",
    "app-core": "workspace:*",
    "app-feature-loader": "workspace:*",
    "discord.js": "catalog:",
    "domain-model": "workspace:*",
    "infra-database": "workspace:*",
    "infra-discord": "workspace:*",
    "infra-http": "workspace:*",
    "infra-rankcard": "workspace:*",
    "infra-redis": "workspace:*",
    "infra-rpc": "workspace:*",
    "presentation-bot-kit": "workspace:*",
    "repo-redis": "workspace:*",
    "repo-search": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "bun": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  }
}
