{
  "name": "presentation-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "typecheck": "npm run check",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "setup": "playwright install",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test --config=playwright.prod.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.3.0",
    "@eslint/compat": "2.1.0",
    "@eslint/js": "10.0.1",
    "@fjst/core": "0.4.0",
    "@fjst/sveltekit": "0.4.0",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/addon-svelte-csf": "5.1.2",
    "@storybook/addon-vitest": "10.5.7",
    "@storybook/sveltekit": "10.5.7",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/enhanced-img": "0.11.0",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "4.1.10",
    "@zerodevx/svelte-toast": "0.9.6",
    "bun": "catalog:",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-storybook": "10.5.7",
    "eslint-plugin-svelte": "3.22.0",
    "globals": "17.9.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "storybook": "10.5.7",
    "svelte": "5.56.8",
    "svelte-check": "4.7.5",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vite-plugin-devtools-json": "1.1.0",
    "vitest": "catalog:",
    "vitest-browser-svelte": "3.0.0"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/open-sans": "5.3.0",
    "@qwik.dev/partytown": "0.14.0",
    "@standard-schema/spec": "catalog:",
    "app-core": "workspace:*",
    "app-schedule": "workspace:*",
    "discord.js": "catalog:",
    "dotenv": "17.4.2",
    "infra-database": "workspace:*",
    "infra-discord": "workspace:*",
    "jsonwebtoken": "9.0.3",
    "layerchart": "2.1.1",
    "presentation-bot": "workspace:*",
    "repo-memory": "workspace:*",
    "repo-search": "workspace:*",
    "super-sitemap": "2.0.6",
    "svelte-exmarkdown": "5.0.2",
    "zod": "catalog:"
  },
  "msw": {
    "workerDirectory": [
      "static"
    ]
  }
}
