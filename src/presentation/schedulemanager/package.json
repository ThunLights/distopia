{
  "name": "presentation-schedulemanager",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --env-file=../../../.env run src/index.ts",
    "lint": "oxfmt --check --config ../../../lib/template/oxfmt.config.ts && oxlint --config ../../../lib/template/oxlint.config.ts",
    "lint:fix": "oxlint --fix --config ../../../lib/template/oxlint.config.ts",
    "format": "oxfmt --config ../../../lib/template/oxfmt.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "app-core": "workspace:*",
    "app-feature-loader": "workspace:*",
    "app-schedule": "workspace:*",
    "infra-database": "workspace:*",
    "infra-discord": "workspace:*",
    "infra-redis": "workspace:*",
    "infra-sentry": "workspace:*",
    "node-cron": "4.6.0",
    "presentation-bot-kit": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "bun": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  }
}
