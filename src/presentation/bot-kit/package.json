{
  "name": "presentation-bot-kit",
  "private": true,
  "type": "module",
  "exports": {
    "./base/*": {
      "import": "./src/base/*.ts"
    },
    "./component/*": {
      "import": "./src/component/*.ts"
    },
    "./codeblock": {
      "import": "./src/codeblock.ts"
    },
    "./page/*": {
      "import": "./src/page/*.ts"
    },
    "./feature": {
      "import": "./src/feature.ts"
    },
    "./validator": {
      "import": "./src/validator.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "lint": "oxfmt --check --config ../../../lib/template/oxfmt.config.ts && oxlint --config ../../../lib/template/oxlint.config.ts",
    "lint:fix": "oxlint --fix --config ../../../lib/template/oxlint.config.ts",
    "format": "oxfmt --config ../../../lib/template/oxfmt.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:",
    "app-core": "workspace:*",
    "deepmerge": "4.3.1",
    "discord.js": "catalog:",
    "domain-model": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "bun": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  }
}
